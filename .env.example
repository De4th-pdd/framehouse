# ==========================================
# FRAMEHOUSE STUDIO — ENVIRONMENT CONFIG
# ==========================================

# 1. NOTIFICATION EMAIL RECIPIENT
# Where inbound project briefs and contact inquiries are sent
NOTIFICATION_EMAIL=hello@framehouse.com

# 2. RESEND (RECOMMENDED FOR EMAIL DELIVERY)
# Sign up at https://resend.com, create an API key, and optionally verify your domain
# If left blank, inquiries will still be safely persisted to data/inquiries.json
RESEND_API_KEY=

# Optional: Verified sender address in Resend (default fallback is onboarding@resend.dev)
# RESEND_FROM_EMAIL=Framehouse Studio <inquiries@framehouse.pk>

# 3. NOTIFICATION WEBHOOK (DISCORD OR SLACK)
# Instant push notifications to your mobile/desktop whenever a brief is submitted
# Discord format: https://discord.com/api/webhooks/...
# Slack format: https://hooks.slack.com/services/...
NOTIFICATION_WEBHOOK_URL=
